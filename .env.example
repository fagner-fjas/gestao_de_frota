# Copie este arquivo para .env: cp .env.example .env
# Segredos: gere valores exclusivos. NUNCA publique o .env real.
DJANGO_SECRET_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_LONGA
DJANGO_DEBUG=1
# Inclua o IP ou nome real do host apenas se acessar de outro computador.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco MySQL, criado no container db quando o volume está vazio.
DB_NAME=frota_mvp
DB_USER=frota_user
DB_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
DB_ROOT_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE
DB_HOST=db
DB_PORT=3306

# API REST Traccar (hostname é o serviço Docker, NÃO localhost).
TRACCAR_URL=http://traccar:8082
# Preencha após gerar token na interface do Traccar.
TRACCAR_API_TOKEN=

# Portas publicadas no computador host (opcionais).
# O padrão permite acessar a aplicação apenas pelo próprio PC.
WEB_BIND_IP=127.0.0.1
WEB_PORT=8000
TRACCAR_WEB_PORT=8082

# Para receber GPS de um celular na mesma rede Wi-Fi, substitua por
# IPv4 LAN DO PC que executa Docker (ex.: 192.168.1.50).
# Não confunda com IP do container. Libere só a rede autorizada no firewall.
TRACCAR_DEVICE_BIND_IP=127.0.0.1
TRACCAR_DEVICE_PORT=5055
